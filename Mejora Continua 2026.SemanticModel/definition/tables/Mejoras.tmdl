table Mejoras
	lineageTag: 5dd2c96e-ea96-4458-8cdc-7315b8fa92f8

	measure 'Mejoras totales' = COUNTROWS ( Mejoras ) + 0
		formatString: 0
		lineageTag: a6c623de-dfe0-4534-bc57-6794772c9120

	measure Implementadas = CALCULATE ( COUNTROWS ( Mejoras ), KEEPFILTERS ( Mejoras[Estado] = "IMPLEMENTADA" ) ) + 0
		formatString: 0
		lineageTag: 5edef461-77e1-422a-8492-bc9ef70acc27

	measure 'En proceso' = CALCULATE ( COUNTROWS ( Mejoras ), KEEPFILTERS ( Mejoras[Estado] = "EN PROCESO" ) ) + 0
		formatString: 0
		lineageTag: 374cc0d7-fcc5-4356-9514-14f5aea8a1a2

	measure 'No iniciadas' = CALCULATE ( COUNTROWS ( Mejoras ), KEEPFILTERS ( Mejoras[Estado] = "NO INICIADO" ) ) + 0
		formatString: 0
		lineageTag: 93226a32-02aa-45ff-b800-293d0afd724c

	measure '% Implementadas' = DIVIDE ( [Implementadas], [Mejoras totales] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1ac2fa13-e31d-4e34-87a9-06994fac2c16

	measure '% En proceso' = DIVIDE ( [En proceso], [Mejoras totales] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a0001107-a353-4c2c-bcd7-a29b824f4967

	measure '% No iniciadas' = DIVIDE ( [No iniciadas], [Mejoras totales] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c4ec621e-b956-4607-beef-a38f66ed8a33

	measure 'Con impacto economico' = CALCULATE ( COUNTROWS ( Mejoras ), KEEPFILTERS ( Mejoras[Impacto economico] = "SI" ) ) + 0
		formatString: 0
		lineageTag: 3863e6f8-f1e6-41b2-a67d-c8740f4e96a9

	measure 'Texto % Implementadas' = FORMAT ( [% Implementadas], "0.0%" ) & " del total"
		displayFolder: Tarjetas
		lineageTag: e0d20ad6-1112-4b2b-9b90-b068fe9fecc1

	measure 'Texto % En proceso' = FORMAT ( [% En proceso], "0.0%" ) & " del total"
		displayFolder: Tarjetas
		lineageTag: 5a450771-6d1f-48f7-b71d-57b02fdb513f

	measure 'Texto % No iniciadas' = FORMAT ( [% No iniciadas], "0.0%" ) & " del total"
		displayFolder: Tarjetas
		lineageTag: 1b3c156d-bb45-4253-96e5-02e9cab178a9

	measure 'Texto impacto economico' = [Con impacto economico] & " con impacto económico"
		displayFolder: Tarjetas
		lineageTag: f6be4f91-1b45-46a3-a4ee-940280456c1d

	measure 'Color Estado' = SWITCH ( SELECTEDVALUE ( Mejoras[Estado] ), "IMPLEMENTADA", "#1F9D63", "EN PROCESO", "#E8A317", "NO INICIADO", "#D4533B", "#8A97A3" )
		displayFolder: Formato
		lineageTag: 654d3bf7-4ef2-4cbc-be5d-748e3429ff81

