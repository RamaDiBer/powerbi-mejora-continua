	column MesNum
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 54b84743-5b6f-477a-befd-0afad7ff892d
		summarizeBy: none
		sourceColumn: MesNum

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: ae781440-576c-42e1-a9dd-aa90c7feffdf
		summarizeBy: none
		sourceColumn: Mes
		sortByColumn: MesNum

		annotation SummarizationSetBy = Automatic

	partition Mejoras = m
		mode: import
		source =
				let
				    // 1) Archivo Excel (la ruta sale del parámetro RutaExcel)
				    Origen = Excel.Workbook(File.Contents(RutaExcel), null, true),
				
				    // 2) Hoja BASE: la fila 1 es el título, los encabezados están en la fila 2
				    Hoja = Origen{[Item = "BASE", Kind = "Sheet"]}[Data],
				    SinTitulo = Table.Skip(Hoja, 1),
				    Encabezados = Table.PromoteHeaders(SinTitulo, [PromoteAllScalars = true]),
				
				    // 3) Limpiar espacios y saltos de línea en los nombres de columna
				    //    ("EQUIPO ", "RESPONSABLE<salto>CARGA IDOC", "IMPACTO <salto>ECONÓMICO")
				    Limpias = Table.TransformColumnNames(Encabezados, each
				        Text.Combine(List.Select(Text.SplitAny(Text.From(_), " #(lf)#(cr)#(tab)"), each _ <> ""), " ")),
				
				    // 4) Quedarse solo con las columnas útiles
				    Columnas = Table.SelectColumns(Limpias, {
				        "N°", "DESCRIPCIÓN DE MEJORAS", "ACCIÓN", "IMPLEMENTADO", "SITIO", "UNIDAD",
				        "PUESTO", "STATUS IDOC", "RESPONSABLE CARGA IDOC", "STATUS", "IMPACTO ECONÓMICO"}, MissingField.UseNull),
				
				    // 5) Sacar las filas vacías (la tabla tiene filas de relleno)
				    SoloConDatos = Table.SelectRows(Columnas, each
				        [#"DESCRIPCIÓN DE MEJORAS"] <> null and Text.Trim(Text.From([#"DESCRIPCIÓN DE MEJORAS"])) <> ""),
				
				    // 6) Fecha de implementación: puede venir como fecha, número o texto (dd/MM/yy o dd/MM/yyyy)
				    Fechas = Table.TransformColumns(SoloConDatos, {{"IMPLEMENTADO", each
				        if _ = null then null
				        else if Value.Is(_, type datetime) or Value.Is(_, type date) or Value.Is(_, type number) then Date.From(_)
				        else try Date.FromText(Text.Trim(Text.From(_)), [Format = "dd/MM/yy", Culture = "es-AR"])
				        otherwise try Date.FromText(Text.Trim(Text.From(_)), [Format = "dd/MM/yyyy", Culture = "es-AR"])
				        otherwise null, type nullable date}}),
				
				    // 7) Columnas normalizadas
				    Texto = (v, vacio) => let t = Text.Trim(Text.From(v ?? "")) in if t = "" then vacio else t,
				    Nro = Table.AddColumn(Fechas, "Nro", each try Int64.From([#"N°"]) otherwise null, Int64.Type),
				    Estado = Table.AddColumn(Nro, "Estado", each Text.Upper(Texto([STATUS], "SIN ESTADO")), type text),
				    StatusIdoc = Table.AddColumn(Estado, "Status IDOC", each Text.Upper(Texto([STATUS IDOC], "SIN ESTADO")), type text),
				    Responsable = Table.AddColumn(StatusIdoc, "Responsable", each Texto([RESPONSABLE CARGA IDOC], "Sin asignar"), type text),
				    Impacto = Table.AddColumn(Responsable, "Impacto economico", each Text.Upper(Texto([IMPACTO ECONÓMICO], "SIN DATO")), type text),
				    Unidad = Table.AddColumn(Impacto, "Unidad", each Texto([UNIDAD], "Sin unidad"), type text),
				    Sitio = Table.AddColumn(Unidad, "Sitio", each Texto([SITIO], "Sin sitio"), type text),
				    Puesto = Table.AddColumn(Sitio, "Puesto", each Texto([PUESTO], "Sin puesto"), type text),
				    Mejora = Table.AddColumn(Puesto, "Mejora", each Text.Trim(Text.From([#"DESCRIPCIÓN DE MEJORAS"])), type text),
				    Accion = Table.AddColumn(Mejora, "Accion", each Texto([ACCIÓN], ""), type text),
				    MesNum = Table.AddColumn(Accion, "MesNum", each
				        if [IMPLEMENTADO] = null then 13 else Date.Month([IMPLEMENTADO]), Int64.Type),
				    Mes = Table.AddColumn(MesNum, "Mes", each
				        if [MesNum] = 13 then "Sin fecha"
				        else {"ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"}{[MesNum] - 1}, type text),
				    ConFecha = Table.RenameColumns(Mes, {{"IMPLEMENTADO", "Fecha implementacion"}}),
				
				    Final = Table.SelectColumns(ConFecha, {
				        "Nro", "Mejora", "Accion", "Fecha implementacion", "Sitio", "Unidad", "Puesto",
				        "Status IDOC", "Estado", "Responsable", "Impacto economico", "MesNum", "Mes"})
				in
				    Final

	annotation PBI_ResultType = Table

